---
import '../styles/fonts.css';import '../styles/global.css';import '../styles/hero.css';
import {cabinet} from '../data/site';
import Header from '../components/Header.astro';import Logo from '../components/Logo.astro';
interface Props {title?:string;description?:string}
const {title='Aurélie Couffort — Pédicure-podologue à Saint-Laurent-du-Var',description='Comprendre le pied, la marche et le mouvement. Pédicure-podologue à Saint-Laurent-du-Var : enfant, sport, soins et semelles. Informations du cabinet et rendez-vous sur Doctolib.'}=Astro.props;
const indexable=import.meta.env.PUBLIC_INDEXABLE==='true'&&!!Astro.site;
const canonical=Astro.site?new URL(Astro.url.pathname,Astro.site):undefined;
const business = {'@context':'https://schema.org','@type':'MedicalBusiness',name:`${cabinet.name} — ${cabinet.title}`,telephone:'+33489223961',address:{'@type':'PostalAddress',streetAddress:cabinet.address,postalCode:cabinet.postalCode,addressLocality:cabinet.city,addressCountry:'FR'},sameAs:cabinet.profileUrl,identifier:{'@type':'PropertyValue',propertyID:'RPPS',value:cabinet.rpps},openingHoursSpecification:[{'@type':'OpeningHoursSpecification',dayOfWeek:['Monday','Tuesday','Wednesday','Thursday','Friday'],opens:'08:00',closes:'19:00'},{'@type':'OpeningHoursSpecification',dayOfWeek:'Saturday',opens:'08:00',closes:'12:00'}],...(Astro.site ? {url:Astro.site.href}: {})};
---
<!doctype html><html lang="fr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="robots" content={indexable?'index,follow':'noindex,nofollow'}/><meta name="theme-color" content="#F6F1EA"/><title>{title}</title>{canonical&&<link rel="canonical" href={canonical}/>}<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content="fr_FR"/>{Astro.site&&<meta property="og:image" content={new URL('/images/hero-960.webp',Astro.site)}/>}<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/favicon-32.png" sizes="32x32"/>{Astro.url.pathname==='/' && <script type="application/ld+json" set:html={JSON.stringify(business).replace(/</g,'\\u003c')}/>}</head><body class:list={{home: Astro.url.pathname === '/'}}><a class="skip" href="#main">Aller au contenu</a><Header/><main id="main"><slot/></main><footer class="wrap"><div class="footer-top"><a href="/#accueil" class="brand-link"><Logo/></a><address>{cabinet.address}<br/>{cabinet.postalCode} {cabinet.city}<br/><a href={cabinet.phoneHref}>{cabinet.phone}</a><br/><small>RPPS : {cabinet.rpps}</small></address><div><a href="/#podologie-enfant">Podologie de l’enfant</a><a href="/#podologie-sport">Podologie du sport</a><a href="/#soins">Les soins</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Aurélie Couffort</span><div><a href="/mentions-legales/">Mentions légales</a><a href="/confidentialite/">Confidentialité</a><a href="/#contact">Contact</a></div></div><p class="dev-note">Version de travail · Textes, identité et informations professionnelles à valider. Photos réelles du cabinet fournies par la praticienne via le porteur du projet ; autres images d’ambiance générées, sans patients réels.</p></footer><script>import '../scripts/interactions';</script></body></html>
