---
import {expertise} from '../data/site';import Photo from './Photo.astro';import Button from './Button.astro';
interface Props {item:typeof expertise[number]}
const {item}=Astro.props;
---
<section id={item.id} class:list={['expertise',item.type]}><div class="wrap expertise-grid"><div class="expertise-visual"><div class="photo-frame parallax"><Photo name={item.image} alt={item.alt}/></div>{item.type==='sport'&&<figure class="insole-detail"><Photo name="semelles" alt="Illustration générée : semelles génériques sauge et bleu encre, sans représentation du matériel du cabinet."/><figcaption>Matières & appuis · visuel d’ambiance</figcaption></figure>}<span class="photo-caption">{item.tags}</span><div class="photo-stamp" aria-hidden="true">{item.type==='enfant'?'À chaque pas,':'Comprendre'}<br/><em>{item.type==='enfant'?'une découverte.':'le mouvement.'}</em></div></div><div class="expertise-copy"><p class="eyebrow">{item.label}</p><h2>{item.label}<span class="editorial-title">{item.title}</span></h2><p class="lead">{item.intro}</p><div class="points">{item.points.map(([title,text],i)=><div class="point"><span class="point-number">0{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></div>)}</div>{item.type==='sport'&&<aside class="pending"><strong>L’expérience de terrain d’Aurélie</strong><p>Parcours, sports pratiqués et expériences professionnelles : présentation à compléter avec Aurélie.</p><small>Lorem ipsum — contenu biographique en attente.</small></aside>}<Button href="/#contact">{item.cta}</Button><p class="validation">Présentation éditoriale proposée · à valider avec Aurélie.</p></div></div></section>
