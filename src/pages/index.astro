---
import Layout from '../layouts/Layout.astro';import Button from '../components/Button.astro';import Photo from '../components/Photo.astro';import Icon from '../components/Icon.astro';import Logo from '../components/Logo.astro';import Expertise from '../components/Expertise.astro';
import {expertise,services,steps,faq,advice,cabinet} from '../data/site';
---
<Layout>
<section class="hero wrap" id="accueil"><div class="hero-copy"><p class="eyebrow"><span></span> La podologie, à votre écoute</p><h1>Des pieds en<br class="desktop-break"/> bonne santé pour<br class="desktop-break"/> une vie <em>plus légère.</em></h1><p class="hero-intro">De la croissance de l’enfant à la pratique sportive, une approche attentive pour comprendre le pied, la marche et le mouvement.</p><div class="hero-actions"><Button href="#contact">Prendre rendez-vous</Button><a class="text-link" href="#expertises">Découvrir les expertises <Icon name="down"/></a></div><div class="hero-paths">{expertise.map((x,i)=><a href={`#${x.id}`}><span class="path-number">0{i+1}</span><span><strong>{x.label}</strong><small>{x.tags}</small></span><Icon/></a>)}</div></div><div class="hero-art"><div class="hero-orbit" aria-hidden="true"></div><div class="hero-photo parallax"><Photo name="hero" alt="Illustration générée : des pieds nus en mouvement sur un parquet clair." eager/></div><span class="vertical-caption">Écouter · Observer · Comprendre</span><div class="hero-note"><span class="fine-line"></span><p>Tout commence<br/>par <em>un appui.</em></p></div><svg class="movement-line" viewBox="0 0 250 450" fill="none" aria-hidden="true"><path d="M190 5c-70 130 90 200-30 300-60 50-140 55-120 100 10 25 70 25 120-10M210 5c-75 135 80 210-35 310-60 50-140 55-120 85 10 15 60 15 95-5" stroke="currentColor" stroke-width="1"/></svg></div><div class="hero-bottom"><span>Grandir &nbsp; / &nbsp; Marcher &nbsp; / &nbsp; Bouger</span><a href="#expertises" aria-label="Explorer la suite"><Icon name="down"/></a><span>Une approche, à chaque étape.</span></div></section>
<section class="intro-section wrap" id="expertises"><div class="section-heading"><p class="eyebrow">Deux regards, une même attention</p><h2>Accompagner le mouvement,<br/><em>à chaque étape de la vie.</em></h2><p>Des premiers pas aux chemins que l’on choisit : comprendre vos appuis commence par comprendre votre quotidien.</p></div><div class="expertise-cards">{expertise.map((x,i)=><a href={`#${x.id}`} class:list={['expertise-card',x.type]}><Photo name={x.image} alt=""/><div><span class="eyebrow">0{i+1} — {x.tags}</span><h3>{x.label}</h3><p>{i===0?'Grandir, explorer, trouver ses appuis.':'Bouger, pratiquer, comprendre ses appuis.'}</p><span class="circle-arrow"><Icon/></span></div></a>)}</div></section>
<Expertise item={expertise[0]}/><Expertise item={expertise[1]}/>
<section class="wrap section" id="soins"><div class="split-heading"><div><p class="eyebrow">Au-delà des premiers pas et du sport</p><h2>La podologie,<br/><em>au quotidien aussi.</em></h2></div><p>Une même attention portée à vos besoins. Ces familles de prestations sont proposées pour la présentation du cabinet et restent à confirmer.</p></div><div class="services">{services.map(([icon,title,summary,detail])=><article class="service"><span class="icon-disc"><Icon name={icon}/></span><h3>{title}</h3><p>{summary}</p><details><summary>En savoir plus <Icon name="plus"/></summary><p>{detail}</p><a href="#contact">Informations de consultation <Icon/></a></details></article>)}</div></section>
<section class="consultation" id="consultation"><div class="wrap"><div class="section-heading"><p class="eyebrow">La consultation, simplement</p><h2>Prendre le temps<br/><em>de comprendre.</em></h2><p>Un parcours proposé pour vous donner des repères. Le déroulement précis sera confirmé avec Aurélie.</p></div><ol class="timeline">{steps.map(([title,copy],i)=><li><span>0{i+1}</span><h3>{title}</h3><p>{copy}</p></li>)}</ol><div class="context-notes"><p><strong>Avec votre enfant</strong> Une place pour sa parole et pour vos questions de parent.</p><p><strong>Dans un contexte sportif</strong> Un échange sur votre pratique, vos sensations et votre chaussage.</p></div></div></section>
<section class="wrap section about" id="a-propos"><div class="portrait-placeholder"><Logo compact/><span>Le regard d’Aurélie</span><p>Portrait professionnel<br/>à venir</p><small>Un espace réservé à sa vraie photographie.</small></div><div><p class="eyebrow">Aurélie Couffort · Pédicure-podologue</p><h2>Une approche attentive,<br/><em>le goût de transmettre.</em></h2><p class="lead">Expliquer clairement son métier, accueillir avec chaleur et faire comprendre le rôle du pied : les intentions qui guident ce projet.</p><blockquote>« Le pied, c’est beau<br/>dans sa complexité. »<cite>Aurélie · questionnaire de personnalité</cite></blockquote><p class="pending">Son parcours, ses formations et sa pratique au cabinet seront présentés ici après validation. <span>Lorem ipsum — biographie à compléter.</span></p><a class="text-link" href="#contact">Découvrir les informations du cabinet <Icon/></a></div></section>
<section class="anatomy" id="comprendre-le-pied"><div class="wrap anatomy-grid"><div class="anatomy-art"><img src="/images/anatomie.png" alt="Illustration anatomique historique du squelette du pied vue médiale, d’après Gray’s Anatomy." width="500" height="189" loading="lazy"/><small>Planche anatomique historique · légendes et usage pédagogique à valider.</small></div><div><p class="eyebrow">Comprendre le pied</p><h2>Une anatomie complexe.<br/><em>Un mouvement naturel.</em></h2><p class="lead">Du premier pas à la pratique sportive, le pied participe aux appuis, à l’équilibre et au mouvement.</p><p>Observer cette structure, c’est aussi prendre le temps d’expliquer ce que l’on voit. Une approche pédagogique qui relie les deux univers du cabinet.</p><div class="anatomy-words"><span>Appuis</span><span>Équilibre</span><span>Mouvement</span></div><p class="validation">Contenu pédagogique proposé, à relire par Aurélie.</p></div></div></section>
<section class="wrap section" id="conseils"><div class="split-heading"><div><p class="eyebrow">Les clés pour comprendre</p><h2>Des questions du quotidien.<br/><em>Des explications accessibles.</em></h2></div><p>Un futur espace de pédagogie, à enrichir avec les conseils d’Aurélie.</p></div><div class="advice-grid">{advice.map(x=><article class="advice"><Photo name={x.image} alt=""/><div><p class="eyebrow">{x.category}</p><h3>{x.title}</h3><p>{x.topics}</p><details><summary>Voir le sujet <Icon name="plus"/></summary><p>Article en préparation. Lorem ipsum — les conseils cliniques seront rédigés et validés par Aurélie avant publication.</p></details></div></article>)}</div></section>
<section id="faq" class="faq-section"><div class="wrap faq-grid"><div class="faq-intro"><p class="eyebrow">Vos questions</p><h2>Tout simplement,<br/><em>en parler.</em></h2><p>Enfant, sport, informations pratiques : retrouvez les réponses par sujet.</p><p class="validation">Les réponses cliniques et pratiques sont provisoires ou à compléter.</p><a class="text-link" href="#contact">Informations du cabinet <Icon/></a></div><div class="faq-groups">{faq.map(group=><section aria-label={group.name}><h3>{group.name}</h3>{group.questions.map(([q,a])=><details><summary>{q}<Icon name="plus"/></summary><p>{a}</p></details>)}</section>)}</div></div></section>
<section class="wrap contact-section" id="contact"><div class="contact-panel"><div><p class="eyebrow">Le cabinet · Informations pratiques</p><h2>Un premier échange,<br/><em>pour avancer.</em></h2><p>{cabinet.name}<br/>{cabinet.title}</p><div class="contact-status"><Icon name="calendar"/><div><strong>Prise de rendez-vous bientôt disponible</strong><p>Le lien de réservation sera ajouté après validation par Aurélie.</p></div></div></div><dl class="contact-data"><div><dt>Adresse & accès</dt><dd>Adresse, accessibilité et stationnement à confirmer.</dd></div><div><dt>Téléphone & email</dt><dd>Coordonnées professionnelles à renseigner.</dd></div><div><dt>Horaires & tarifs</dt><dd>Horaires, tarifs et modalités de remboursement à confirmer.</dd></div></dl></div></section>
</Layout>
